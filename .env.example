ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_PROJECT_NAME=yingke

# 方案一：复用控制台已创建的视觉创作 Agent
ARK_AGENT_ID=
# 可选：不填时第一次真实创作会创建云端 Environment 并缓存
ARK_ENVIRONMENT_ID=

# 方案二：不填 Agent ID，指定控制台支持的模型后自动创建 Agent
ARK_AGENT_MODEL=
ARK_IMAGE_MODEL=
# 可选：启用视频生成工具需要配置可用的视频模型
ARK_VIDEO_MODEL=

# 私域虚拟素材库及可选真人素材 API 使用 AK/SK；API Key 用于 Files 临时托管和 Agent
ARK_ACCESS_KEY=
ARK_SECRET_KEY=
ARK_SESSION_TOKEN=
ARK_ASSET_GROUP_ID=
# 虚拟素材库无需回调。以下仅用于可选的真人资料入库接口
# 真人 H5 活体认证结束后的公网 HTTPS 回调页；可以是你自己的回调页
# 本机页面通过查询接口核实认证结果，不信任浏览器传来的成功标记
# 可将 public/portrait-callback/ 独立部署到自己的 HTTPS 站点
ARK_REAL_PERSON_CALLBACK_URL=

HOST=127.0.0.1
PORT=3000
# 最多同时执行的创作任务数；超出后在后台排队，仍可继续提交
MAX_CONCURRENT_TASKS=3
